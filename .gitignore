# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
dist/
.vercel/

# Cloudflare Workers (OpenNext) build output and local state.
# `.open-next/` is written by `opennextjs-cloudflare build` — the Worker
# bundle plus the static assets it uploads. `.wrangler/` is wrangler's local
# cache and the local-mode storage used by `npm run preview`. Both are
# regenerated on every build; neither is ever uploaded.
.open-next/
.wrangler/

# `npm run cf-typegen` output: ~625 KB of generated workerd runtime types.
# Nothing in this project consumes them — there is no TypeScript here and no
# tsconfig — so it is regenerated on demand rather than committed and
# re-churned on every wrangler bump.
cloudflare-env.d.ts

# Local Cloudflare dev variables — same rule as .env.local: may hold a real
# secret, so it is never committed.
.dev.vars
.dev.vars.*

# Environment — only .env.example is committed, and it holds variable NAMES only.
# Never commit a file with a real key in it.
.env
.env.local
.env*.local
.env.development
.env.production

# EXCEPTION, deployment branches only (godaddy, cloudflare): .env.production
# is committed there so the build carries its own NEXT_PUBLIC_* values instead
# of depending on when the host injects them (see CLAUDE.md > Build-time
# environment variables, and > Hosting: Cloudflare). Everything in it is
# inlined into the browser bundle by `next build` and is public already. A
# real secret must never be added to it; .env.local stays ignored above, on
# every branch.
!.env.production

# Logs and local test output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
test-results/
playwright-report/

# Local working folders — screenshots and scratch output are build artefacts of
# a working session, not source.
screenshots/
scratchpad/
_archive/

# Tooling / editor / agent state
.claude/
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Source policy documents (content/source-policies/*.pdf) — the originals the
# published /legal pages were written from. Kept out of the repo on purpose:
# they are internal working documents, not site content, and they must never
# be served from public/. The published text in app/legal/ is the deliverable.
content/source-policies/

# "Save page as" dumps must never reach public/.
#
# A Flipkart product listing was once saved straight into
# public/media/iriz/ as `iriz_photo.html` + `iriz_photo_files/` — 6 MB of
# third-party JavaScript, CSS, vendor SVGs and COMPETITOR product
# photography, all of it uploaded to the edge and publicly fetchable at
# /media/iriz/iriz_photo.html. Nothing referenced it, which is exactly why
# it survived review: an unreferenced file in public/ is still a served
# file. check-media only validates that referenced paths EXIST, so it could
# not have caught this.
#
# These two rules are scoped to public/media so the design-src/ mocks and
# board sources (`design-src/images/*.html`) are unaffected.
public/media/**/*.html
public/media/**/*_files/

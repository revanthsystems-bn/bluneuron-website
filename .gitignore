# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
dist/
.vercel/

# Environment — only .env.example is committed, and it holds variable NAMES only.
# Never commit a file with a real key in it.
.env
.env.local
.env*.local
.env.development
.env.production

# EXCEPTION, godaddy branch only: .env.production is committed here so the
# GoDaddy build carries its own NEXT_PUBLIC_* values instead of depending on
# when the host injects them (see CLAUDE.md > Build-time environment
# variables). Everything in it is inlined into the browser bundle by
# `next build` and is public already. A real secret must never be added to
# it; .env.local stays ignored above, on every branch.
!.env.production

# Logs and local test output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
test-results/
playwright-report/

# Local working folders — screenshots and scratch output are build artefacts of
# a working session, not source.
screenshots/
scratchpad/
_archive/

# Tooling / editor / agent state
.claude/
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Web3Forms access key — powers the "Notify Me" signup (components/Newsletter,
# components/NewsletterPopup) and the checkout reservation email.
#
# Copy this file to .env.local and fill in the key from https://web3forms.com/
# .env.local is gitignored; this example file is not, so never put the real
# key here.
#
# Without it the forms render normally but refuse to submit, logging a warning
# naming this variable rather than silently appearing to succeed.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Meta (Facebook) Pixel ID — powers PageView on every page and the `Lead`
# event on a successful "Notify Me" signup (components/MetaPixel, lib/metaPixel).
#
# Set it in .env.local for local work and in Vercel → Settings → Environment
# Variables for deployments. A Pixel ID is not a secret — it ships in the page
# source of every site that runs one — but it stays in the environment so a
# preview deployment can point at a different pixel, or at none.
#
# Leave it empty and the pixel is not loaded at all: no script, no noscript
# fallback, no events. The same is true on localhost regardless of this value,
# so local testing never sends fake visits to Meta.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID — the `G-XXXXXXXXXX` value from Google
# Analytics → Admin → Data streams → (your web stream) → Measurement ID.
#
# OPTIONAL. Leave it empty and Google Analytics is not loaded at all: no
# script, no page views, no events, and no warning — an unset GA property is
# a supported state, not an error. The same is true on localhost regardless
# of this value. See lib/googleAnalytics.js.
#
# This is the one analytics variable that does NOT stop a production build
# when it is missing; NEXT_PUBLIC_META_PIXEL_ID and NEXT_PUBLIC_WEB3FORMS_KEY
# both do (scripts/assert-build-env.js).
#
# TODO(analytics): fill this in once the GA4 property exists.
NEXT_PUBLIC_GA_ID=

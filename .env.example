# Web3Forms access key — powers the "Notify Me" signup (components/Newsletter,
# components/NewsletterPopup) and the checkout reservation email.
#
# Copy this file to .env.local and fill in the key from https://web3forms.com/
# .env.local is gitignored; this example file is not, so never put the real
# key here.
#
# Without it the forms render normally but refuse to submit, logging a warning
# naming this variable rather than silently appearing to succeed.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Apps Script web app used by warranty registration.
# These are server-only values; do not prefix them with NEXT_PUBLIC_.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Meta (Facebook) Pixel ID — powers PageView on every page and the `Lead`
# event on a successful "Notify Me" signup (components/MetaPixel, lib/metaPixel).
#
# Set it in .env.local for local work and in Vercel → Settings → Environment
# Variables for deployments. A Pixel ID is not a secret — it ships in the page
# source of every site that runs one — but it stays in the environment so a
# preview deployment can point at a different pixel, or at none.
#
# Leave it empty and the pixel is not loaded at all: no script, no noscript
# fallback, no events. The same is true on localhost regardless of this value,
# so local testing never sends fake visits to Meta.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID — the `G-XXXXXXXXXX` value from Google
# Analytics → Admin → Data streams → (your web stream) → Measurement ID.
#
# OPTIONAL. Leave it empty and Google Analytics is not loaded at all: no
# script, no page views, no events, and no warning — an unset GA property is
# a supported state, not an error. The same is true on localhost regardless
# of this value. See lib/googleAnalytics.js.
#
# This is the one analytics variable that does NOT stop a production build
# when it is missing; NEXT_PUBLIC_META_PIXEL_ID and NEXT_PUBLIC_WEB3FORMS_KEY
# both do (scripts/assert-build-env.js).
#
# TODO(analytics): fill this in once the GA4 property exists.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Supabase — the account area (sign-in, warranty registration, claims).
# ---------------------------------------------------------------------------
#
# BOTH ARE BROWSER VALUES, and both must be present at BUILD time: they are
# NEXT_PUBLIC_, so `next build` inlines them into the bundle. Setting them only
# in a hosting dashboard that injects at runtime produces a build that is
# already in demo mode.
#
# LEAVE BOTH EMPTY and the site runs in DEMO MODE: /sign-in accepts any
# six-digit code, the account pages render clearly-labelled fixture data, and
# a banner says so on every one of them. That is a supported state for review.
# `scripts/check-production.js` refuses a production deploy while it is on.
#
# The project URL, from Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE (anon) key — Supabase → Project Settings → API keys.
#
# This one is public by design. It ships in the page source of every site that
# uses Supabase, and it is not what protects the data: Row Level Security is.
# Every table carries a policy restricting rows to `auth.uid() = user_id`, so
# this key grants exactly the access an anonymous visitor should have. See
# supabase/migrations/0001_accounts.sql, and supabase/rls-tests.sql to prove it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NOT HERE, and never: SUPABASE_SERVICE_ROLE_KEY.
#
# It bypasses Row Level Security completely. Nothing in this application needs
# it — every read and write happens as the signed-in user. If a server-only
# task ever genuinely requires it, it belongs in a Cloudflare secret
# (`wrangler secret put SUPABASE_SERVICE_ROLE_KEY`), read only inside a server
# route, never prefixed NEXT_PUBLIC_, and never written into any .env file that
# git can see.
#
# SMTP credentials are not here either. OTP emails are sent by Supabase, not by
# this application, so the Gmail app password lives in the Supabase dashboard
# (Authentication → Emails → SMTP Settings) and nowhere in this repository.
# See docs/supabase-setup.md.
# ---------------------------------------------------------------------------

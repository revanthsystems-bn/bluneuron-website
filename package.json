{
  "name": "bluneuron-website",
  "version": "1.0.0",
  "description": "Marketing and pre-launch signup site for the BluNeuron IRIZ projector.",
  "main": "next.config.js",
  "engines": {
    "node": ">=20.9 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "validate:seo": "node scripts/validate-seo.js",
    "check:media": "node scripts/check-media.js",
    "check:production": "node scripts/check-production.js",
    "test:cart": "node scripts/test-cart-flow.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:upload": "opennextjs-cloudflare build && wrangler versions upload",
    "deploy": "npm run check:production && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:buy": "node scripts/test-buy-links.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.149.0"
  }
}

# Build-time public values for the GoDaddy Node.js build (this branch only).
#
# WHY THIS FILE IS COMMITTED, when .gitignore lists it and .env.local is never
# committed anywhere: every value below is a NEXT_PUBLIC_* value, which
# `next build` INLINES into the browser bundle. It is therefore in the page
# source of every visitor's browser already, and committing it leaks nothing.
#
# GoDaddy loads environment variables "when your app starts" — possibly AFTER
# the build — so a panel-only configuration produces a build with the Meta
# Pixel missing and a signup form that rejects every submission, silently.
# scripts/assert-build-env.js stops the build instead; this file is what
# satisfies it, so the build carries its own values and does not depend on
# when the host injects them.
#
# PUBLIC, BROWSER-VISIBLE VALUES ONLY. A real secret — a privileged API key, a
# payment gateway secret, a database URL — must never be added here; those stay
# in .env.local, which is gitignored on every branch.

# Meta (Facebook) Pixel ID — PageView on every page, `Lead` on signup.
NEXT_PUBLIC_META_PIXEL_ID=1043089155423260

# Web3Forms access key — the "Notify Me" signup and the checkout reservation.
NEXT_PUBLIC_WEB3FORMS_KEY=8e9288cf-4bcf-4179-b5b8-5b44c5340e5e

# Google Analytics 4 Measurement ID — host-independent analytics, runs on both
# Vercel and GoDaddy. Optional by design; this property now exists.
NEXT_PUBLIC_GA_ID=G-2KNVQ4LVNY
